{
  "name": "lazyprojectmanager",
  "version": "1.16.21",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "docker compose -f docker/compose.yml --project-directory . --profile app up -d --build --wait",
    "stop": "docker compose -f docker/compose.yml --project-directory . --profile app down",
    "restart": "pnpm stop && pnpm start",
    "bump": "node scripts/version.mjs bump",
    "version:current": "node scripts/version.mjs current",
    "release": "node scripts/release-tag.mjs",
    "logs": "docker compose -f docker/compose.yml --project-directory . --profile app logs -f",
    "dev": "docker compose -f docker/compose.yml --project-directory . stop app && pnpm stack:up && pnpm build && pnpm db:migrate && concurrently --kill-others --names types,server,client --prefix-colors blue,green,magenta \"tsc --build --watch --preserveWatchOutput\" \"pnpm --filter @lpm/server dev\" \"pnpm --filter @lpm/client dev\"",
    "build": "tsc --build && pnpm -r --if-present build:assets",
    "typecheck": "tsc --build --force && tsc -p config/tsconfig.eslint.json --noEmit",
    "lint": "eslint . --config config/eslint.config.js",
    "lint:fix": "eslint . --config config/eslint.config.js --fix",
    "format": "prettier --write . --config config/.prettierrc.json",
    "format:check": "prettier --check . --config config/.prettierrc.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:e2e": "pnpm build && playwright test --config config/playwright.config.ts",
    "screenshots": "pnpm build && playwright test --config config/playwright.screenshots.config.ts",
    "db:migrate": "node --env-file=.env app/Database/dist/migrate-cli.js",
    "seed:demo": "node --env-file=.env app/Server/dist/seed-demo-cli.js",
    "fake-forge": "node scripts/fake-forge.mjs",
    "stack:up": "docker compose -f docker/compose.yml --project-directory . up -d --wait",
    "stack:down": "docker compose -f docker/compose.yml --project-directory . down",
    "stack:reset": "docker compose -f docker/compose.yml --project-directory . --profile app down -v",
    "stack:logs": "docker compose -f docker/compose.yml --project-directory . logs -f",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "globals": "15.15.0",
    "ioredis": "5.11.1",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2"
    }
  }
}
