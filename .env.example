# Copy to .env and adjust. .env is gitignored; this file is the only one committed.

NODE_ENV=development

# --- API process -------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# The public origin this install is reached on. Behind a Cloudflare tunnel this
# is the tunnel hostname (https://pm.example.com), not the container address.
# Session cookies and webhook callback URLs are built from it.
BASE_URL=http://localhost:5173

# Shown on the connect-to-server screen so an operator can confirm the box.
SERVER_NAME=LazyProjectManager

# The key the few secrets the API must read back are encrypted with — a
# repository's webhook secret, and its GitHub App private key. Generate one with
# `openssl rand -base64 32`. Only needed once a repository is connected; change
# it and the connections made under the old one stop verifying.
APP_SECRET=

# Set to true when the API sits behind a reverse proxy or a Cloudflare tunnel, so
# Fastify reads the client address and protocol from the forwarded headers.
# Leave false when the API is exposed directly, or forged headers are trusted.
TRUST_PROXY=false

# --- Backing services --------------------------------------------------------
DATABASE_URL=postgres://lpm:lpm@localhost:5432/lpm
REDIS_URL=redis://localhost:6379

# How the API reaches the store, and the only address it has. A browser never
# talks to it: files are fetched and sent through the API, so there is nothing
# here that has to be resolvable from anywhere but this machine.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lpm
S3_ACCESS_KEY=lpm
S3_SECRET_KEY=lpm-dev-secret
S3_FORCE_PATH_STYLE=true

# --- The Docker stack (pnpm start) -------------------------------------------
# Docker Compose reads this file too, for the ${...} values in compose.yml.

# Public origin of the containerised app. Behind a Cloudflare tunnel set this to
# the tunnel hostname. Named APP_BASE_URL rather than BASE_URL because BASE_URL
# above is the Vite dev server and the container must not be handed that.
# Defaults to http://localhost:$APP_PORT when unset.
# APP_BASE_URL=https://pm.example.com

# Host port the web UI is published on. High and unregistered, so it will not
# collide with anything else on the box and leaves :3000 free for `pnpm dev`.
APP_PORT=24571
MINIO_CONSOLE_PORT=9001

# Change both before exposing an install to anything.
POSTGRES_PASSWORD=lpm
MINIO_PASSWORD=lpm-dev-secret

# --- Worker ------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
