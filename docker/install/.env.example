# Copy to .env and change the passwords before exposing this install.

# --- Required ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me
MINIO_PASSWORD=change-me-too

# The key the webhook secrets are encrypted with. There is no default on
# purpose: a default would be the same key on every install, which is the same
# as not encrypting them. Only needed once a repository is connected, and the
# screen says so plainly when it is missing. Generate one with:
#
#   openssl rand -base64 32
#
# Keep it. Changing it stops every connected repository verifying, because it is
# the key their secrets were written with.
APP_SECRET=

# --- The address people reach it on ------------------------------------------
# One address for the whole install. Files are fetched and sent through the app,
# so a tunnel needs one hostname and there is no second one to get right.
#
# Behind a Cloudflare tunnel, set this to the tunnel hostname and TRUST_PROXY to
# true. Without TRUST_PROXY the API sees every request as coming from the tunnel
# connector, and secure-cookie detection breaks.
#
# On a machine other people reach over the network, set it to that address —
# session cookies and the webhook address are built from it, so leaving it as
# localhost gets you through setup and into stranger problems afterwards.
# APP_BASE_URL=https://pm.example.com
# TRUST_PROXY=true

SERVER_NAME=LazyProjectManager

# --- Ports on the host -------------------------------------------------------
APP_PORT=24571
MINIO_CONSOLE_PORT=9001

# --- Version -----------------------------------------------------------------
# Pinned by the release this folder came from. Change it deliberately, then
# `docker compose pull && docker compose up -d`.
LPM_VERSION=latest
