{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "rootDir": "./src",
    "outDir": "./dist-types",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // `*.test-support.ts` is the harness a test reads the source with — it uses
  // `node:fs`, which the browser build has no types for and no use for.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test-support.ts"],
  "references": [{ "path": "../Shared" }]
}
