# pnpm's non-flat node_modules is a module boundary we rely on: a package can only
# import what it declares in its own package.json. Hoisting would let app/Server
# quietly import a transitive dependency of app/Database, and the layering in
# docs/Engineering-Rules.md would rot without anyone noticing.
strict-peer-dependencies=true

# Workspace packages always resolve to the local source, never to a published
# version that happens to share the name.
link-workspace-packages=true
prefer-workspace-packages=true
